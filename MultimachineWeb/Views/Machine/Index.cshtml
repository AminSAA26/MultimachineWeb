<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Application & Infrastructure Dashboard</title>
	<!-- 1. Load jQuery First -->
<!-- <script src="https://googleapis.com"></script> -->
    <!-- Hosted on cdnjs to avoid connection issues -->
    <!-- <script src="https://cloudflare.com"></script>  -->
