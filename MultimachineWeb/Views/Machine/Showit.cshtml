    function generateIssueGraph(m_data) 
    {

        m_data.forEach(i => {
            if (i.IssuesList.length > 0) {
                // 2. Count total matches
                let openCount = 0;
                let resolvedCount = 0;
                var _openbar = '#open-bar_' + i.jsonRecordID;
                var _resolvedbar = '#resolved-bar_' + i.jsonRecordID;
                $(_openbar).css('width', 0 + '%');
                $(_resolvedbar).css('width', 0 + '%');

                i.IssuesList.forEach(issue => {
                    //$('#storage-slider').css('width', '0%');
                    if (issue.Resolution_Status === 'Open') openCount++;
                    if (issue.Resolution_Status === 'Resolved') resolvedCount++;
                });
                const totalIssues = openCount + resolvedCount;
                // 3. Calculate percentages for bar widths
                const openPercentage = i.IssuesList.length > 0 ? (openCount / totalIssues) * 100 : 0;
                const resolvedPercentage = i.IssuesList.length > 0 ? (resolvedCount / totalIssues) * 100 : 0;
                console.log('application ' + i.Application);
                console.log('openPercentage ' + openPercentage)
                console.log('resolvedPercentage ' + resolvedPercentage)

                // Apply widths smoothly via CSS transitions
                
                $(_openbar).css('width', openPercentage + '%').attr('data-tooltip', `Open: ${openCount} (${openPercentage.toFixed(1)}%)`);;
                $(_resolvedbar).css('width', resolvedPercentage + '%').attr('data-tooltip', `Resolved: ${resolvedCount} (${resolvedPercentage.toFixed(1)}%)`);;

                // $('#open-bar').css('width', openPercentage + '%');
                // $('#resolved-bar').css('width', resolvedPercentage + '%');

                 }
                    else {        }
        });
    }


