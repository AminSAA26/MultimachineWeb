                i.IssuesList.forEach(item => {
                    if (item.Resolution_Status === "Open") {
                        openCount++;
                    } else if (item.Resolution_Status === "Resolved") {
                        resolvedCount++;
                    }
                });
            } else {
                // FIX 2: Correctly increment counter if there are no issues
                noIssueCount++;
            }

            const _id = 'IssuesPieChart_' + i.jsonRecordID;
            const canvasElement = document.getElementById(_id);

            if (!canvasElement) return; // Guard clause if canvas doesn't exist yet

            const ctx = canvasElement.getContext('2d');

            // FIX 3: Destroy the previous chart instance if it exists
            // to prevent canvas memory leaks and animation breaks.
            if (window[_id] instanceof Chart) {
                window[_id].destroy();
            }

            // Save the new chart instance globally linked to its specific ID
            window[_id] = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    datasets: [{
                        data: [openCount, resolvedCount, noIssueCount],
                        backgroundColor: [
                            '#fce8e6', // Soft Red for Open
                            '#e6f4ea', // Soft Green for Resolved
                            '#faffbd'  // Soft Yellow for No Issue
                        ],
                        borderColor: [
                            '#f28b82', // Darker Red Border
                            '#81c995', // Darker Green Border
                            '#ffdf00'  // Darker Yellow Border
                        ],
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    animation: {
                        duration: 2000, // FIX 4: Changed to 2000ms (2 seconds) so it finishes well before any refresh loop
                        easing: 'easeOutQuart',
                    }
                }
            });
        });
    }

    // FIX 5: Remove the automatic recursive setTimeout loop from inside the function itself.
    // Call it once when your DOM or data is ready:
    //generateIssuePie(records);

</script>

