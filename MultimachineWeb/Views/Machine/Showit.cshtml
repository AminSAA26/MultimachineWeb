         box-shadow: 0 4px 16px rgba(0,0,0,0.1), 0 1px 2px rgba(0,0,0,0.05);
         box-sizing: border-box;
         padding: 24px;
         font-family: 'Roboto' , 'Segoe UI' , Arial, sans-serif;
">
            @* <div id="data" style="position:relative;width:100%;height:180%;background-color:whitesmoke"> *@
            <div id="data" style="position:relative;">
                <div style="margin-bottom: 12px;">
                    <label id="issuelabel" style="display:block; font-weight:bold;">Description:</label>
                    @* <textarea id="edit-desc" rows="3" style="width: 100%; box-sizing: border-box;height:200px;border-radius: 8px;box-shadow: 0 4px 16px rgba(0,0,0,0.1), 0 1px 2px rgba(0,0,0,0.05);"></textarea> *@
                    <div class="table-wrapper" style="height: 300px;">
                        <table style="width: 100%; border-collapse: collapse;">
                            <thead>
                                <tr>
                                    <th>RID</th>
                                    <th>AppID</th>
                                    <th>AppName</th>
                                    <th>Description</th>
                                    <th>Reported_Date</th>
                                    <th>Reported_Time</th>
                                    <th>Resolution_Date</th>
                                    <th>Resolution_Time</th>
                                    <th>Duration</th>
                                    <th>Status</th>
                                    <th>MC_RecordID</th>
                                    <th>EntryDate</th>
                                </tr>
                            </thead>
                            <tbody id="data-rows-popup">
                                <!-- Targeted dynamic content insertion point via jQuery -->
                            </tbody>
                        </table>
                    </div>
                </div>
                @*   <div style="display: flex; gap: 15px; align-items: flex-start; margin-bottom: 12px;">

                <div style="margin-bottom: 12px;">
                <label style="display:block; font-weight:bold;">Reported Date:</label>
                <input type="date" id="edit-reported" style="width: 150px;border: 1px solid #dadce0;;">
                </div>

                <div style="margin-bottom: 12px;">
                <label style="display:block; font-weight:bold;">Resolution Date:</label>
                <input type="date" id="edit-resolved" style="width: 150px;border: 1px solid #dadce0;">
                </div>

                <div style="margin-bottom: 12px;">
                <label style="display:block; font-weight:bold;">Duration:</label>
                <input type="text" id="edit-duration" style="width: 100px;border: 1px solid #dadce0;;">
                </div>

                <div style="margin-bottom: 12px;">
                <label style="display:block; font-weight:bold;">Status:</label>
                <select id="edit-status" style="width: 150px;border: 1px solid #dadce0;;">
                <option value="Open">Open</option>
                <option value="In Progress">In Progress</option>
                <option value="Resolved">Resolved</option>
                </select>
                </div>
                </div> *@
                <hr style="margin-top: 15px;">
                <div style="text-align: right;">
                    <button id="close-popup" style="background:#ccc; border:none; padding:8px 15px; cursor:pointer; margin-right:5px;">Cancel</button>
                    <button id="save-popup" style="background:#0066cc; color:#fff; border:none; padding:8px 15px; cursor:pointer;">Save Changes</button>
                </div>

            </div>
            @*   <p>This is your popup content!</p>
            <div id="tool">
            <button id="close-popup" style="background-color:whitesmoke;box-shadow: 0 8px 16px 0 rgba(0,0,0,0.6);">Close</button>
            <button id="save-popup" style="background-color:whitesmoke;box-shadow: 0 8px 16px 0 rgba(0,0,0,0.6);">Save</button>
            </div> *@

        </div>
</body>
